# Drag-and-drop PyMOL script generated by pharmacophore-toolkit (PLI)
set auto_zoom, off

set_color obj01_pli_hbond_color, [0.0000, 1.0000, 0.0000]
set_color obj01_pli_hbond_donor_color, [0.2549, 0.4118, 0.8824]
set_color obj01_pli_hbond_acceptor_color, [1.0000, 0.2706, 0.0000]
set_color obj01_pli_hydrophobic_color, [0.1804, 0.5451, 0.3412]
set_color obj01_pli_pi_stacking_color, [0.8549, 0.6471, 0.1255]
set_color obj01_pli_cation_pi_color, [0.8549, 0.6471, 0.1255]
set_color obj01_pli_ionic_color, [0.7294, 0.3333, 0.8275]
set_color obj01_pli_clash_color, [0.8627, 0.0784, 0.2353]
recolor

select obj01_pli_pocket_residues, polymer.protein and ((chain A and resi 155) or (chain A and resi 156) or (chain A and resi 242) or (chain A and resi 339) or (chain A and resi 340))
deselect
show lines, obj01_pli_pocket_residues
set line_width, 3.0, obj01_pli_pocket_residues
util.cnc obj01_pli_pocket_residues

pseudoatom _pli_tmp_a, pos=[122.415, 135.171, 95.208]
pseudoatom _pli_tmp_b, pos=[121.383, 137.252, 96.018]
distance obj01_ionic_ASP155_1, _pli_tmp_a, _pli_tmp_b
delete _pli_tmp_a
delete _pli_tmp_b
set dash_color, obj01_pli_ionic_color, obj01_ionic_ASP155_1
set dash_width, 5.0, obj01_ionic_ASP155_1
set dash_radius, 0.12, obj01_ionic_ASP155_1
hide labels, obj01_ionic_ASP155_1

pseudoatom _pli_tmp_a, pos=[129.239, 137.7, 96.259]
pseudoatom _pli_tmp_b, pos=[132.287, 136.677, 97.152]
distance obj01_hbond_SER242_2, _pli_tmp_a, _pli_tmp_b
delete _pli_tmp_a
delete _pli_tmp_b
set dash_color, obj01_pli_hbond_color, obj01_hbond_SER242_2
set dash_width, 5.0, obj01_hbond_SER242_2
set dash_radius, 0.12, obj01_hbond_SER242_2
hide labels, obj01_hbond_SER242_2

pseudoatom _pli_tmp_a, pos=[126.7308, 137.907, 95.0675]
pseudoatom _pli_tmp_b, pos=[126.0503, 134.0822, 91.1887]
distance obj01_pistack_PHE339_3, _pli_tmp_a, _pli_tmp_b
delete _pli_tmp_a
delete _pli_tmp_b
set dash_color, obj01_pli_pi_stacking_color, obj01_pistack_PHE339_3
set dash_width, 5.0, obj01_pistack_PHE339_3
set dash_radius, 0.12, obj01_pistack_PHE339_3
hide labels, obj01_pistack_PHE339_3

pseudoatom _pli_tmp_a, pos=[126.7308, 137.907, 95.0675]
pseudoatom _pli_tmp_b, pos=[130.2468, 133.912, 93.8503]
distance obj01_pistack_PHE340_4, _pli_tmp_a, _pli_tmp_b
delete _pli_tmp_a
delete _pli_tmp_b
set dash_color, obj01_pli_pi_stacking_color, obj01_pistack_PHE340_4
set dash_width, 5.0, obj01_pistack_PHE340_4
set dash_radius, 0.12, obj01_pistack_PHE340_4
hide labels, obj01_pistack_PHE340_4

group obj01_pli_interactions, obj01_pli_pocket_residues obj01_ionic_ASP155_1 obj01_hbond_SER242_2 obj01_pistack_PHE339_3 obj01_pistack_PHE340_4
set auto_zoom, on
zoom obj01_pli_pocket_residues, 6
