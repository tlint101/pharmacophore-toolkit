# Drag-and-drop PyMOL script generated by pharmacophore-toolkit (Pharmacophore)
set auto_zoom, off

set_color psilocin_donor_color, [0.2549, 0.4118, 0.8824]
set_color psilocin_acceptor_color, [1.0000, 0.2706, 0.0000]
set_color psilocin_aromatic_color, [0.8549, 0.6471, 0.1255]
set_color psilocin_hydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color psilocin_lumpedhydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color psilocin_posionizable_color, [0.0000, 0.7490, 1.0000]
set_color psilocin_negionizable_color, [0.7294, 0.3333, 0.8275]
pseudoatom psilocin_Donor_1, pos=[-0.9079048054626491, -2.273514568696311, 0.18159371873241614]
pseudoatom psilocin_Acceptor_1, pos=[2.7823527868743723, -2.323157111361419, -1.9953865738341623]
pseudoatom psilocin_Aromatic_1, pos=[-1.8302781079689001, 0.2747279625010338, -0.19357889519840255]
pseudoatom psilocin_Aromatic_2, pos=[-0.39083710422756, -1.2919787666034073, -0.19321988166312415]
pseudoatom psilocin_Hydrophobe_1, pos=[3.1103421091283114, -2.4809486937177208, -2.4367674373205106]
pseudoatom psilocin_Hydrophobe_2, pos=[3.9546599621423413, -3.178497680448727, -1.9440975268745984]
pseudoatom psilocin_Hydrophobe_3, pos=[2.5940135783682217, -1.9411912893430172, -3.3708182112527716]

show spheres, psilocin_Donor_*
color psilocin_donor_color, psilocin_Donor_*
set sphere_scale, 0.7, psilocin_Donor_*

show spheres, psilocin_Acceptor_*
color psilocin_acceptor_color, psilocin_Acceptor_*
set sphere_scale, 0.7, psilocin_Acceptor_*

show spheres, psilocin_Aromatic_*
color psilocin_aromatic_color, psilocin_Aromatic_*
set sphere_scale, 0.7, psilocin_Aromatic_*

show spheres, psilocin_Hydrophobe_*
color psilocin_hydrophobe_color, psilocin_Hydrophobe_*
set sphere_scale, 0.7, psilocin_Hydrophobe_*

python
import math as _math
from pymol import cmd as _cmd, cgo as _cgo
_ph_prev_az = _cmd.get('auto_zoom')
_cmd.set('auto_zoom', 0, quiet=1)
_cmd.pseudoatom('_ph_vdw_probe', pos=[0.0, 0.0, 0.0], quiet=1)
_ph_mdl = _cmd.get_model('_ph_vdw_probe')
_ph_base_r = float(_ph_mdl.atom[0].vdw) if (_ph_mdl.atom and float(_ph_mdl.atom[0].vdw) > 0) else 1.0
_cmd.delete('_ph_vdw_probe')
_cmd.set('auto_zoom', _ph_prev_az, quiet=1)
_ph_r = _ph_base_r * 0.7
def _ph_load_wedge(name, cx, cy, cz, r, rgb, phi0, phi1, transp):
    n_lat, n_lon = 20, 16
    stride = n_lon + 1
    verts, norms = [], []
    for i in range(n_lat + 1):
        th = _math.pi * i / n_lat
        st, ct = _math.sin(th), _math.cos(th)
        for j in range(n_lon + 1):
            ph = phi0 + (phi1 - phi0) * j / n_lon
            nx, ny, nz = st * _math.sin(ph), ct, st * _math.cos(ph)
            verts.append((cx + r * nx, cy + r * ny, cz + r * nz))
            norms.append((nx, ny, nz))
    obj = [_cgo.BEGIN, _cgo.TRIANGLES, _cgo.COLOR, rgb[0], rgb[1], rgb[2]]
    for i in range(n_lat):
        for j in range(n_lon):
            v00 = i * stride + j
            v10 = (i + 1) * stride + j
            v11 = (i + 1) * stride + (j + 1)
            v01 = i * stride + (j + 1)
            if i > 0:
                for k in (v00, v11, v01):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
            if i < n_lat - 1:
                for k in (v00, v10, v11):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
    obj.append(_cgo.END)
    _cmd.load_cgo(obj, name)
    if transp > 0.0:
        _cmd.set('cgo_transparency', transp, name)
_ph_load_wedge('psilocin_Donor_2', 0.06619, 2.08429, -1.13360, _ph_r, (0.2549, 0.4118, 0.8824), 0.000000, 3.141593, 0.0)
_ph_load_wedge('psilocin_Acceptor_2', 0.06619, 2.08429, -1.13360, _ph_r, (1.0000, 0.2706, 0.0000), 3.141593, 6.283185, 0.0)
python end
group psilocin_pharmacophore, psilocin_Donor_1 psilocin_Donor_2 psilocin_Acceptor_1 psilocin_Acceptor_2 psilocin_Aromatic_1 psilocin_Aromatic_2 psilocin_Hydrophobe_1 psilocin_Hydrophobe_2 psilocin_Hydrophobe_3
set auto_zoom, on
