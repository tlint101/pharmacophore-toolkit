# Drag-and-drop PyMOL script generated by pharmacophore-toolkit (Pharmacophore)
set auto_zoom, off

set_color mescaline_donor_color, [0.2549, 0.4118, 0.8824]
set_color mescaline_acceptor_color, [1.0000, 0.2706, 0.0000]
set_color mescaline_aromatic_color, [0.8549, 0.6471, 0.1255]
set_color mescaline_hydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color mescaline_lumpedhydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color mescaline_posionizable_color, [0.0000, 0.7490, 1.0000]
set_color mescaline_negionizable_color, [0.7294, 0.3333, 0.8275]
pseudoatom mescaline_Acceptor_2, pos=[-3.7007956487890734, -1.6754178892330178, 0.41721988259070153]
pseudoatom mescaline_Acceptor_3, pos=[-2.673329556223355, 2.9028392558637317, -0.7438624225629216]
pseudoatom mescaline_Acceptor_4, pos=[-4.51910574128911, 1.0030375033355887, -0.18646147471801772]
pseudoatom mescaline_Aromatic_1, pos=[-1.852254697062097, 0.29325060421060906, -0.15696536406685527]
pseudoatom mescaline_Hydrophobe_1, pos=[-1.7634084944586785, 3.94195340995073, -1.0434482727451895]
pseudoatom mescaline_Hydrophobe_2, pos=[-5.4261748727479775, 1.0065242287114986, -1.2307441878690324]
pseudoatom mescaline_Hydrophobe_3, pos=[-3.33966015281976, -2.9927118315955545, 0.7163093212750997]

show spheres, mescaline_Acceptor_*
color mescaline_acceptor_color, mescaline_Acceptor_*
set sphere_scale, 0.7, mescaline_Acceptor_*

show spheres, mescaline_Aromatic_*
color mescaline_aromatic_color, mescaline_Aromatic_*
set sphere_scale, 0.7, mescaline_Aromatic_*

show spheres, mescaline_Hydrophobe_*
color mescaline_hydrophobe_color, mescaline_Hydrophobe_*
set sphere_scale, 0.7, mescaline_Hydrophobe_*

python
import math as _math
from pymol import cmd as _cmd, cgo as _cgo
_ph_prev_az = _cmd.get('auto_zoom')
_cmd.set('auto_zoom', 0, quiet=1)
_cmd.pseudoatom('_ph_vdw_probe', pos=[0.0, 0.0, 0.0], quiet=1)
_ph_mdl = _cmd.get_model('_ph_vdw_probe')
_ph_base_r = float(_ph_mdl.atom[0].vdw) if (_ph_mdl.atom and float(_ph_mdl.atom[0].vdw) > 0) else 1.0
_cmd.delete('_ph_vdw_probe')
_cmd.set('auto_zoom', _ph_prev_az, quiet=1)
_ph_r = _ph_base_r * 0.7
def _ph_load_wedge(name, cx, cy, cz, r, rgb, phi0, phi1, transp):
    n_lat, n_lon = 20, 16
    stride = n_lon + 1
    verts, norms = [], []
    for i in range(n_lat + 1):
        th = _math.pi * i / n_lat
        st, ct = _math.sin(th), _math.cos(th)
        for j in range(n_lon + 1):
            ph = phi0 + (phi1 - phi0) * j / n_lon
            nx, ny, nz = st * _math.sin(ph), ct, st * _math.cos(ph)
            verts.append((cx + r * nx, cy + r * ny, cz + r * nz))
            norms.append((nx, ny, nz))
    obj = [_cgo.BEGIN, _cgo.TRIANGLES, _cgo.COLOR, rgb[0], rgb[1], rgb[2]]
    for i in range(n_lat):
        for j in range(n_lon):
            v00 = i * stride + j
            v10 = (i + 1) * stride + j
            v11 = (i + 1) * stride + (j + 1)
            v01 = i * stride + (j + 1)
            if i > 0:
                for k in (v00, v11, v01):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
            if i < n_lat - 1:
                for k in (v00, v10, v11):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
    obj.append(_cgo.END)
    _cmd.load_cgo(obj, name)
    if transp > 0.0:
        _cmd.set('cgo_transparency', transp, name)
_ph_load_wedge('mescaline_Donor_1', 2.95567, -0.28090, 1.14161, _ph_r, (0.2549, 0.4118, 0.8824), 0.000000, 3.141593, 0.0)
_ph_load_wedge('mescaline_Acceptor_1', 2.95567, -0.28090, 1.14161, _ph_r, (1.0000, 0.2706, 0.0000), 3.141593, 6.283185, 0.0)
python end
group mescaline_pharmacophore, mescaline_Donor_1 mescaline_Acceptor_1 mescaline_Acceptor_2 mescaline_Acceptor_3 mescaline_Acceptor_4 mescaline_Aromatic_1 mescaline_Hydrophobe_1 mescaline_Hydrophobe_2 mescaline_Hydrophobe_3
set auto_zoom, on
