# Drag-and-drop PyMOL script generated by pharmacophore-toolkit (Pharmacophore)
set auto_zoom, off

set_color serotonin_donor_color, [0.2549, 0.4118, 0.8824]
set_color serotonin_acceptor_color, [1.0000, 0.2706, 0.0000]
set_color serotonin_aromatic_color, [0.8549, 0.6471, 0.1255]
set_color serotonin_hydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color serotonin_lumpedhydrophobe_color, [0.1804, 0.5451, 0.3412]
set_color serotonin_posionizable_color, [0.0000, 0.7490, 1.0000]
set_color serotonin_negionizable_color, [0.7294, 0.3333, 0.8275]
pseudoatom serotonin_Donor_1, pos=[-0.8973394405866356, -2.2339928518128245, 0.16926424955326683]
pseudoatom serotonin_Aromatic_1, pos=[-1.8488193745711363, 0.28046047863089374, -0.18979012903776135]
pseudoatom serotonin_Aromatic_2, pos=[-0.3807464011518379, -1.2713835572401853, -0.200729372039918]

show spheres, serotonin_Donor_*
color serotonin_donor_color, serotonin_Donor_*
set sphere_scale, 0.7, serotonin_Donor_*

show spheres, serotonin_Aromatic_*
color serotonin_aromatic_color, serotonin_Aromatic_*
set sphere_scale, 0.7, serotonin_Aromatic_*

python
import math as _math
from pymol import cmd as _cmd, cgo as _cgo
_ph_prev_az = _cmd.get('auto_zoom')
_cmd.set('auto_zoom', 0, quiet=1)
_cmd.pseudoatom('_ph_vdw_probe', pos=[0.0, 0.0, 0.0], quiet=1)
_ph_mdl = _cmd.get_model('_ph_vdw_probe')
_ph_base_r = float(_ph_mdl.atom[0].vdw) if (_ph_mdl.atom and float(_ph_mdl.atom[0].vdw) > 0) else 1.0
_cmd.delete('_ph_vdw_probe')
_cmd.set('auto_zoom', _ph_prev_az, quiet=1)
_ph_r = _ph_base_r * 0.7
def _ph_load_wedge(name, cx, cy, cz, r, rgb, phi0, phi1, transp):
    n_lat, n_lon = 20, 16
    stride = n_lon + 1
    verts, norms = [], []
    for i in range(n_lat + 1):
        th = _math.pi * i / n_lat
        st, ct = _math.sin(th), _math.cos(th)
        for j in range(n_lon + 1):
            ph = phi0 + (phi1 - phi0) * j / n_lon
            nx, ny, nz = st * _math.sin(ph), ct, st * _math.cos(ph)
            verts.append((cx + r * nx, cy + r * ny, cz + r * nz))
            norms.append((nx, ny, nz))
    obj = [_cgo.BEGIN, _cgo.TRIANGLES, _cgo.COLOR, rgb[0], rgb[1], rgb[2]]
    for i in range(n_lat):
        for j in range(n_lon):
            v00 = i * stride + j
            v10 = (i + 1) * stride + j
            v11 = (i + 1) * stride + (j + 1)
            v01 = i * stride + (j + 1)
            if i > 0:
                for k in (v00, v11, v01):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
            if i < n_lat - 1:
                for k in (v00, v10, v11):
                    obj.extend([_cgo.NORMAL, *norms[k], _cgo.VERTEX, *verts[k]])
    obj.append(_cgo.END)
    _cmd.load_cgo(obj, name)
    if transp > 0.0:
        _cmd.set('cgo_transparency', transp, name)
_ph_load_wedge('serotonin_Donor_2', 2.94185, -0.19888, 1.20637, _ph_r, (0.2549, 0.4118, 0.8824), 0.000000, 3.141593, 0.0)
_ph_load_wedge('serotonin_Donor_3', -2.58328, 2.89700, -0.63020, _ph_r, (0.2549, 0.4118, 0.8824), 0.000000, 3.141593, 0.0)
_ph_load_wedge('serotonin_Acceptor_1', 2.94185, -0.19888, 1.20637, _ph_r, (1.0000, 0.2706, 0.0000), 3.141593, 6.283185, 0.0)
_ph_load_wedge('serotonin_Acceptor_2', -2.58328, 2.89700, -0.63020, _ph_r, (1.0000, 0.2706, 0.0000), 3.141593, 6.283185, 0.0)
python end
group serotonin_pharmacophore, serotonin_Donor_1 serotonin_Donor_2 serotonin_Donor_3 serotonin_Acceptor_1 serotonin_Acceptor_2 serotonin_Aromatic_1 serotonin_Aromatic_2
set auto_zoom, on
